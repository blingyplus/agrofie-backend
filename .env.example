# Application
DATABASE_URL=postgres://agrofie:agrofie@localhost:5432/agrofie?sslmode=disable
REDIS_URL=redis://localhost:6380/0

# Service URLs (gateway → internal)
AUTH_URL=http://localhost:8081
BOOKING_URL=http://localhost:8082
PAYMENTS_URL=http://localhost:8083

# Ory Kratos (identity)
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434

# Local admin seed (make seed-admin) — never commit real passwords
ADMIN_EMAIL=admin@agrofie.local
ADMIN_PASSWORD=changeme-admin
ADMIN_DISPLAY_NAME=Agrofie Admin

# Demo talent (make seed-talent) — local dev only, never reuse this password anywhere real
SEED_TALENT_PASSWORD=changeme-seed-talent
SEED_ORGANIZER_PASSWORD=changeme-seed-organizer
# `make seed-demo` (idempotent) creates, all TEST values:
#   admin      admin@agrofie.local            / ADMIN_PASSWORD (default changeme-admin)
#   organizer  demo.organizer@agrofie.local   / SEED_ORGANIZER_PASSWORD
#   talents    seed.<slug>@agrofie.local      / SEED_TALENT_PASSWORD  (12 acts, e.g. seed.kofi-mensimah@agrofie.local)

# Ports
# gateway 8080 | auth 8081 | booking 8082 | payments 8083
# kratos public 4433 | kratos admin 4434 | mailhog UI 8025

# Paystack (never commit real keys; use test keys — sk_test_...).
# Unset -> the backend uses FakeProvider automatically, so local dev works with no key.
# PAYMENTS_PROVIDER=fake forces the fake provider even when a key is set: checkout opens
# <PUBLIC_BASE_URL>/pay/fake/<reference>, a TEST page whose Pay button runs the real webhook path.
# PAYMENTS_PROVIDER=
# Easy switch (edits .env + recreates containers): make payments-real | make payments-fake
# The active provider is logged at startup and exposed as GraphQL health { paymentsProvider }.
# Gateway origin reachable from your phone (your Mac's LAN IP), used in fake checkout URLs.
PUBLIC_BASE_URL=http://localhost:8080
# Local testing: allow completing a booking before the event date (never in production).
DEV_ALLOW_EARLY_COMPLETE=true
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# Agrofie's share of each booking payment. The talent bears Paystack's processing fee.
COMMISSION_PERCENT=12.5

# Forgot password: Kratos emails a 6-digit code. Local dev delivers to MailHog
# (http://localhost:8025). In production set a REAL SMTP server for Kratos
# (read by docker-compose.yml / your deploy): without it no reset emails go out.
# COURIER_SMTP_CONNECTION_URI=smtps://USER:PASSWORD@smtp.example.com:465/
# COURIER_SMTP_FROM_ADDRESS=no-reply@yourdomain

# Public app config served unauthenticated at GET /config (clients fetch it on start).
# Change WEB_BASE_URL to your real domain and restart the gateway: invite/share links
# update in every installed app without a release. Defaults shown.
# WEB_BASE_URL=https://agrofie.app
# INVITE_URL=            # default: <WEB_BASE_URL>/join
# PROFILE_URL_TEMPLATE=  # default: {webBaseUrl}/t/{id}
# SUPPORT_EMAIL=support@agrofie.app
# MIN_APP_VERSION=0.0.0  # apps older than this show a blocking "Please update" screen
# FEATURE_FLAGS={"socialLogin":true,"talentRequests":true}
# MAINTENANCE_ENABLED=false
# MAINTENANCE_MESSAGE=We are making Agrofie better. Back shortly.

# Uploads (profile photos, covers, verification docs). Local disk for now.
MEDIA_DIR=./data/media
# Signs short-lived links to private media; set a long random value outside local dev.
MEDIA_SIGNING_SECRET=
