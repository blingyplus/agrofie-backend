# Application
DATABASE_URL=postgres://agrofie:agrofie@localhost:5432/agrofie?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Service URLs (gateway → internal)
AUTH_URL=http://localhost:8081
BOOKING_URL=http://localhost:8082
PAYMENTS_URL=http://localhost:8083

# Ory Kratos (identity)
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434

# Local admin seed (make seed-admin) — never commit real passwords
ADMIN_EMAIL=admin@agrofie.local
ADMIN_PASSWORD=changeme-admin
ADMIN_DISPLAY_NAME=Agrofie Admin

# Ports
# gateway 8080 | auth 8081 | booking 8082 | payments 8083
# kratos public 4433 | kratos admin 4434 | mailhog UI 8025

# Paystack (never commit real keys). Scaffold uses FakeProvider.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
