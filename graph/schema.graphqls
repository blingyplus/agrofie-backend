# GraphQL schema for Agrofie gateway.
# Lookups are admin-controlled; clients must not hardcode genres/regions.

scalar Time

directive @authenticated on FIELD_DEFINITION
directive @hasRole(code: String!) on FIELD_DEFINITION

type Query {
  health: Health!
  me: User! @authenticated
  countries(activeOnly: Boolean = true): [Country!]!
  geoPlaces(countryCode: String = "GH", parentCode: String, activeOnly: Boolean = true): [GeoPlace!]!
  genres(activeOnly: Boolean = true): [Lookup!]!
  talentTypes(activeOnly: Boolean = true): [Lookup!]!
  eventTypes(activeOnly: Boolean = true): [Lookup!]!
  languages(activeOnly: Boolean = true): [Lookup!]!
  roles(activeOnly: Boolean = true): [Lookup!]!
  bookingStatuses(activeOnly: Boolean = true): [Lookup!]!
  rateUnits(activeOnly: Boolean = true): [Lookup!]!
  verificationTypes(activeOnly: Boolean = true): [Lookup!]!
  disputeReasons(activeOnly: Boolean = true): [Lookup!]!

  """The caller's own verification history, newest first. Requires the talent role."""
  myVerifications: [Verification!]! @hasRole(code: "talent")

  """Verifications awaiting review, oldest first. Requires the admin role."""
  pendingVerifications: [PendingVerification!]! @hasRole(code: "admin")

  """Searchable, active talent, newest first. Never exposes contact details."""
  searchTalent(filter: TalentFilter, sort: TalentSort = NEWEST, first: Int = 20, after: String): TalentPage!
  talent(id: ID!): TalentProfile

  """The caller's own talent profile, including unpublished changes. Requires the talent role."""
  myTalentProfile: TalentProfile @hasRole(code: "talent")

  """Banks (BANK) or mobile money telcos (MOBILE_MONEY) a talent can settle payouts to."""
  settlementBanks(type: SettlementType!): [SettlementBank!]! @hasRole(code: "talent")

  """The caller's own payout account, if connected. Requires the talent role."""
  myPayoutAccount: PayoutAccount @hasRole(code: "talent")

  """The caller's own published availability, including blackout blocks and notes, in [from, to)."""
  myAvailability(from: String!, to: String!): [AvailabilityBlock!]! @hasRole(code: "talent")

  """A talent's public availability windows in [from, to). No notes."""
  talentAvailability(talentId: ID!, from: String!, to: String!): [AvailabilityWindow!]!

  """The caller's own bookings as the organizer who made them."""
  myBookingsAsOrganizer: [OrganizerBooking!]! @hasRole(code: "organizer")

  """The caller's own bookings as the talent they're for."""
  myBookingsAsTalent: [TalentBooking!]! @hasRole(code: "talent")

  """Full detail, including the contract once agreed. Only the organizer or talent involved can see it."""
  booking(id: ID!): BookingDetail @authenticated

  """A talent's public aggregate rating. Never review authorship at this level."""
  talentReviewSummary(talentId: ID!): ReviewSummary!

  """The admin dispute queue, newest first, optionally filtered to one status. Requires the admin role."""
  disputes(statusCode: String): [AdminDispute!]! @hasRole(code: "admin")

  """The caller's own talent requests, newest first. Requires the organizer role."""
  myTalentRequests: [TalentRequest!]! @hasRole(code: "organizer")

  """The caller's own organizer profile (name, organisation, phone, home region, event types hosted). Requires the organizer role."""
  myOrganizerProfile: OrganizerProfile! @hasRole(code: "organizer")

  """All talent requests, newest first, optionally filtered to one status (open, matched, closed). Requires the admin role."""
  talentRequests(statusCode: String): [TalentRequest!]! @hasRole(code: "admin")
}

type Mutation {
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  logout: Boolean! @authenticated

  """Email a 6-digit recovery code (Kratos recovery, code method). Always returns true for a well-formed address: it never reveals whether the account exists, and is throttled per address (1 per 30s, 5 per hour)."""
  requestPasswordReset(email: String!): Boolean!

  """Redeem the emailed code and set a new password. Signs the account out everywhere. Errors are user-friendly (wrong or expired code, password too weak)."""
  resetPassword(email: String!, code: String!, newPassword: String!): Boolean!

  """Rename a lookup display name. Never changes immutable code."""
  updateLookupName(table: LookupTable!, code: String!, name: String!): Lookup! @hasRole(code: "admin")
  setLookupActive(table: LookupTable!, code: String!, isActive: Boolean!): Lookup! @hasRole(code: "admin")

  """Update the caller's own talent profile. A field left null is unchanged; an empty list clears that tag set."""
  updateMyTalentProfile(input: UpdateTalentProfileInput!): TalentProfile! @hasRole(code: "talent")

  """Replace all of the caller's current rates. Existing rates are closed, not deleted."""
  setMyRates(rates: [RateInput!]!): TalentProfile! @hasRole(code: "talent")

  """Connect (or replace) the caller's payout account via a Paystack subaccount. Test mode until launch review."""
  connectMyPayoutAccount(input: ConnectPayoutInput!): PayoutAccount! @hasRole(code: "talent")

  """Flag (or unflag) a searchable talent as featured on Discover. rank orders featured talent, lower first. Requires the admin role."""
  setTalentFeatured(talentId: ID!, featured: Boolean!, rank: Int): TalentProfile! @hasRole(code: "admin")

  """Submit evidence for review. Approving an identity verification is what makes a talent searchable."""
  submitVerification(input: SubmitVerificationInput!): Verification! @hasRole(code: "talent")

  """Set (or clear with null) the caller's talent photo to a profile_photo they uploaded. Requires the talent role."""
  setTalentPhoto(mediaId: ID): TalentProfile! @hasRole(code: "talent")

  """Set (or clear with null) the caller's cover/banner to a cover_image they uploaded. Requires the talent role."""
  setTalentCover(mediaId: ID): TalentProfile! @hasRole(code: "talent")

  """Approve a pending verification. Requires the admin role."""
  approveVerification(id: ID!, reviewNotes: String): Verification! @hasRole(code: "admin")

  """Reject a pending verification. Requires the admin role."""
  rejectVerification(id: ID!, reviewNotes: String): Verification! @hasRole(code: "admin")

  """Publish a window as available, or carve out a blackout, on the caller's own profile."""
  addMyAvailabilityBlock(input: AddAvailabilityBlockInput!): AvailabilityBlock! @hasRole(code: "talent")

  """Remove one of the caller's own availability blocks."""
  removeMyAvailabilityBlock(id: ID!): Boolean! @hasRole(code: "talent")

  """Request a booking. Nothing is charged yet; the price is looked up server-side from the talent's published rate."""
  requestBooking(input: RequestBookingInput!): OrganizerBooking! @hasRole(code: "organizer")

  """Accept a pending inquiry. Snapshots the contract and moves the booking to agreed."""
  acceptBooking(id: ID!): TalentBooking! @hasRole(code: "talent")

  """Decline a pending inquiry."""
  declineBooking(id: ID!): TalentBooking! @hasRole(code: "talent")

  """Counter a live booking (inquiry or countered) with a new price and optionally new dates and a note. Only the party who did NOT make the last move may counter; at most 6 counters per booking."""
  counterBooking(input: CounterBookingInput!): BookingDetail! @authenticated

  """Accept the other party's latest offer (their turn to respond only): moves the booking to agreed and locks that offer as the contract terms. Works for either party; talents may also use acceptBooking."""
  acceptCounterOffer(id: ID!): BookingDetail! @authenticated

  """Withdraw the caller's own pending inquiry. Once agreed, cancelling goes through a dispute instead."""
  cancelBooking(id: ID!): OrganizerBooking! @hasRole(code: "organizer")

  """Start a Paystack split checkout for an agreed booking the caller organized. The amount is never client-supplied; it is the booking's own snapshotted quote."""
  initiateCheckout(bookingId: ID!): Checkout! @hasRole(code: "organizer")

  """Reconciliation fallback: ask Paystack directly for the latest payment's status, and apply the same effect a webhook would if it succeeded."""
  verifyPayment(bookingId: ID!): Payment! @hasRole(code: "organizer")

  """Confirm a paid booking as completed, once the event window has passed. Either party may confirm it."""
  completeBooking(id: ID!): BookingDetail! @authenticated

  """Leave the caller's one review of the other party on a completed booking."""
  submitReview(input: SubmitReviewInput!): Review! @authenticated

  """Open a dispute on a booking the caller is a party to (organizer or talent), once it's agreed, paid, or completed. Only one unresolved dispute is allowed per booking at a time."""
  openDispute(input: OpenDisputeInput!): Dispute! @authenticated

  """Move a dispute to under_review, resolved, or closed, with an optional note. Never moves money or reopens the booking. Requires the admin role."""
  resolveDispute(id: ID!, statusCode: String!, resolutionNote: String): AdminDispute! @hasRole(code: "admin")

  """Pitch the Agrofie team a request when Discover has nothing suitable. Organizer only; talent are not notified."""
  createTalentRequest(input: TalentRequestInput!): TalentRequest! @hasRole(code: "organizer")

  """Update the caller's own organizer profile. A null field is unchanged; an empty string clears organization/phone/homePlaceCode; an empty list clears eventTypeCodes. Requires the organizer role."""
  updateMyOrganizerProfile(input: UpdateOrganizerProfileInput!): OrganizerProfile! @hasRole(code: "organizer")

  """Move a talent request to open, matched or closed. Requires the admin role."""
  setTalentRequestStatus(id: ID!, statusCode: String!): TalentRequest! @hasRole(code: "admin")
}

input RegisterInput {
  email: String!
  phone: String
  password: String!
  displayName: String!
  roleCode: String!
}

input LoginInput {
  identifier: String!
  password: String!
}

type AuthPayload {
  sessionToken: String!
  user: User!
}

type User {
  id: ID!
  email: String!
  phone: String
  displayName: String!
  roleCodes: [String!]!
}

enum LookupTable {
  GENRES
  TALENT_TYPES
  EVENT_TYPES
  LANGUAGES
  ROLES
  BOOKING_STATUSES
  DISPUTE_REASONS
  CANCELLATION_REASONS
}

type Health {
  status: String!
  service: String!
  auth: String!
  booking: String!
  payments: String!
  "Active payment provider: fake | paystack-test (name only)."
  paymentsProvider: String!
}

type Lookup {
  id: ID!
  code: String!
  name: String!
  sortOrder: Int!
  isActive: Boolean!
}

type Country {
  id: ID!
  code: String!
  name: String!
  isActive: Boolean!
}

type GeoPlace {
  id: ID!
  code: String!
  name: String!
  placeLevel: String!
  parentCode: String
  isActive: Boolean!
}

input TalentFilter {
  genreCodes: [String!]
  typeCodes: [String!]
  languageCodes: [String!]
  """A geo place code; matches that place and everything beneath it."""
  placeCode: String
  """Only admin-featured talent."""
  featuredOnly: Boolean
  """Only talent with at least this many reviews (e.g. for a "Top rated" rail)."""
  minReviewCount: Int
}

enum TalentSort {
  """Newest profile first."""
  NEWEST
  """Highest average rating first, then most reviews. Unrated talent last."""
  TOP_RATED
  """Featured talent first (by rank), then newest."""
  FEATURED
}

type Tag {
  code: String!
  name: String!
}

type Rate {
  """Decimal string, e.g. "150.00"."""
  amount: String!
  currencyCode: String!
  rateUnitCode: String!
  eventTypeCode: String
}

type TalentCard {
  id: ID!
  displayName: String!
  headline: String
  homePlaceName: String
  """Cheapest current rate, if the talent has published one."""
  fromRate: Rate
  genres: [Tag!]!
  types: [Tag!]!
  """Admin-curated placement for the Discover hero."""
  featured: Boolean!
  """Mean of organizer reviews (1-5, 2 dp). Null until the talent has a review."""
  ratingAverage: Float
  reviewCount: Int!
  """When the talent joined Agrofie (RFC 3339). Drives "New on Agrofie"."""
  createdAt: String!
  """Absolute URL of the talent's photo (medium variant), or null."""
  photoUrl: String
  """Absolute URL of the talent's cover/banner (medium variant), or null."""
  coverUrl: String
}

type TalentProfile {
  id: ID!
  displayName: String!
  headline: String
  homePlaceName: String
  """Code of the home place. Only populated on the caller's own profile (myTalentProfile)."""
  homePlaceCode: String
  bio: String
  """Admin-curated placement for the Discover hero."""
  featured: Boolean!
  """Mean of organizer reviews (1-5, 2 dp). Null until the talent has a review."""
  ratingAverage: Float
  reviewCount: Int!
  """When the talent joined Agrofie (RFC 3339). Drives "New on Agrofie"."""
  createdAt: String!
  genres: [Tag!]!
  types: [Tag!]!
  languages: [Tag!]!
  serviceAreas: [Tag!]!
  rates: [Rate!]!
  """Absolute URL of the talent's photo (medium variant), or null."""
  photoUrl: String
  """Absolute URL of the talent's cover/banner (medium variant), or null."""
  coverUrl: String
}

type TalentPage {
  items: [TalentCard!]!
  """Pass as `after` for the next page; null when there are no more results."""
  nextCursor: String
}

input UpdateTalentProfileInput {
  headline: String
  bio: String
  """A geo place code; this is the talent's home base, an exact place. Null or omitted leaves it unchanged; an empty string clears it."""
  homePlaceCode: String
  genreCodes: [String!]
  typeCodes: [String!]
  languageCodes: [String!]
  serviceAreaCodes: [String!]
}

input RateInput {
  """Decimal string, e.g. "150.00"."""
  amount: String!
  currencyCode: String!
  rateUnitCode: String!
  eventTypeCode: String
}

enum SettlementType {
  BANK
  MOBILE_MONEY
}

input ConnectPayoutInput {
  businessName: String!
  settlementType: SettlementType!
  bankCode: String!
  accountNumber: String!
}

type SettlementBank {
  name: String!
  code: String!
}

type PayoutAccount {
  settlementType: SettlementType!
  bankName: String!
  """Last 4 digits only; the full account number is never returned or stored."""
  accountNumberLast4: String!
  accountName: String!
}

input SubmitVerificationInput {
  typeCode: String!
  """Id of a verification_document uploaded via POST /media (must be yours)."""
  mediaId: ID
  """Pasted link; kept for compatibility. Prefer mediaId."""
  evidenceRef: String
  notes: String
}

"""An uploaded file. For private media the url is signed and expires after about 10 minutes; re-query for a fresh one."""
type MediaRef {
  id: ID!
  mime: String!
  url: String!
}

type Verification {
  id: ID!
  evidenceMedia: MediaRef
  typeCode: String!
  typeName: String!
  statusCode: String!
  statusName: String!
  evidenceRef: String
  notes: String
  reviewNotes: String
}

"""One item in the admin review queue."""
type PendingVerification {
  id: ID!
  """The uploaded evidence document (admin view); url is signed and short-lived."""
  evidenceMedia: MediaRef
  talentUserId: ID!
  talentDisplayName: String!
  typeCode: String!
  typeName: String!
  evidenceRef: String
  notes: String
}

"""Dates and times are ISO 8601 strings (e.g. "2026-11-01T00:00:00Z")."""
input AddAvailabilityBlockInput {
  startsAt: String!
  endsAt: String!
  isAvailable: Boolean!
  note: String
}

type AvailabilityBlock {
  id: ID!
  startsAt: String!
  endsAt: String!
  isAvailable: Boolean!
  note: String
}

"""Public-safe: no note."""
type AvailabilityWindow {
  id: ID!
  startsAt: String!
  endsAt: String!
  isAvailable: Boolean!
}

"""Prices are integer pesewas (100 = GHS 1.00), 1 .. 100,000,000. startsAt and endsAt must be given together (or both omitted to keep the current dates)."""
input CounterBookingInput {
  bookingId: ID!
  amountPesewas: Int!
  """Optional; must match the booking currency (GHS)."""
  currencyCode: String
  startsAt: String
  endsAt: String
  note: String
}

"""One proposal in a booking's negotiation trail (round 1 is the organizer's original inquiry)."""
type BookingOffer {
  id: ID!
  round: Int!
  """organizer or talent"""
  byRole: String!
  byName: String!
  byMe: Boolean!
  """Decimal GHS, e.g. "1250.00"."""
  amount: String!
  amountPesewas: Int!
  currencyCode: String!
  startsAt: String!
  endsAt: String!
  note: String
  createdAt: String!
}

"""Dates and times are ISO 8601 strings (e.g. "2026-12-10T00:00:00Z")."""
input RequestBookingInput {
  talentId: ID!
  eventTypeCode: String
  placeCode: String
  startsAt: String!
  endsAt: String!
  venueText: String
  """Which of the talent's current published rates to quote. Never a client-supplied amount."""
  rateUnitCode: String!
  note: String
}

type OrganizerBooking {
  id: ID!
  statusCode: String!
  statusName: String!
  startsAt: String!
  endsAt: String!
  venueText: String
  quotedAmount: String!
  currencyCode: String!
  talentDisplayName: String!
  talentId: ID!
  eventTypeName: String
  """organizer or talent: who made the latest offer."""
  lastOfferByRole: String!
  """Counter-offers made so far (the opening inquiry is not counted)."""
  counterCount: Int!
  """True when the booking is live and the caller owes the next move (accept, counter or decline)."""
  awaitingMyResponse: Boolean!
}

type TalentBooking {
  id: ID!
  statusCode: String!
  statusName: String!
  startsAt: String!
  endsAt: String!
  venueText: String
  quotedAmount: String!
  currencyCode: String!
  organizerDisplayName: String!
  organizerId: ID!
  eventTypeName: String
  """organizer or talent: who made the latest offer."""
  lastOfferByRole: String!
  """Counter-offers made so far (the opening inquiry is not counted)."""
  counterCount: Int!
  """True when the booking is live and the caller owes the next move (accept, counter or decline)."""
  awaitingMyResponse: Boolean!
}

type BookingDetail {
  id: ID!
  statusCode: String!
  statusName: String!
  startsAt: String!
  endsAt: String!
  venueText: String
  quotedAmount: String!
  currencyCode: String!
  organizerDisplayName: String!
  talentDisplayName: String!
  eventTypeName: String
  """Only set once the booking has been accepted."""
  termsText: String
  """organizer or talent: who made the latest offer."""
  lastOfferByRole: String!
  """Counter-offers made so far (the opening inquiry is not counted)."""
  counterCount: Int!
  """True when the booking is live and the caller owes the next move (accept, counter or decline)."""
  awaitingMyResponse: Boolean!
  """Full negotiation trail, oldest first."""
  offers: [BookingOffer!]!
  """The most recent payment attempt for this booking, if any."""
  payment: Payment
  """Every review left on this booking (0, 1, or 2 — one per side)."""
  reviews: [Review!]!
  """Every dispute opened on this booking, newest first."""
  disputes: [Dispute!]!
}

input OpenDisputeInput {
  bookingId: ID!
  reasonCode: String!
  details: String
}

type Dispute {
  id: ID!
  bookingId: ID!
  reasonCode: String!
  reasonName: String!
  statusCode: String!
  statusName: String!
  details: String
  resolutionNote: String
  openedByUserId: ID!
  createdAt: String!
}

"""One item in the admin dispute queue: a dispute plus enough booking context to triage without a follow-up lookup."""
type AdminDispute {
  id: ID!
  bookingId: ID!
  reasonCode: String!
  reasonName: String!
  statusCode: String!
  statusName: String!
  details: String
  resolutionNote: String
  openedByUserId: ID!
  createdAt: String!
  organizerDisplayName: String!
  talentDisplayName: String!
  bookingStatusCode: String!
  startsAt: String!
}

input SubmitReviewInput {
  bookingId: ID!
  """1-5."""
  rating: Int!
  body: String
}

type Review {
  id: ID!
  rating: Int!
  body: String
  createdAt: String!
  authorUserId: ID!
  authorDisplayName: String!
}

type ReviewSummary {
  reviewCount: Int!
  averageRating: Float!
}

"""One Paystack split-checkout attempt for a booking. Amounts are
integer pesewas; commissionPesewas is what Agrofie keeps, the rest
settles to the talent's own subaccount."""
type Payment {
  reference: ID!
  statusCode: String!
  statusName: String!
  amountPesewas: Int!
  commissionPesewas: Int!
  currencyCode: String!
  checkoutUrl: String
}

type Checkout {
  checkoutUrl: String!
  reference: ID!
  amountPesewas: Int!
  commissionPesewas: Int!
}

"""Prices are integer pesewas (100 = GHS 1.00). eventDate is YYYY-MM-DD. At least one field (or a note) is required."""
input TalentRequestInput {
  eventTypeCode: String
  genreCode: String
  placeCode: String
  eventDate: String
  budgetPesewas: Int
  note: String
}

"""An organizer's "Tell us what you need" pitch. Visible only to its organizer and admins; talent are never shown these."""
type TalentRequest {
  id: ID!
  """open, matched or closed."""
  statusCode: String!
  statusName: String!
  eventTypeCode: String
  eventTypeName: String
  genreCode: String
  genreName: String
  placeCode: String
  placeName: String
  eventDate: String
  budgetPesewas: Int
  currencyCode: String!
  note: String!
  createdAt: String!
  organizerDisplayName: String!
}

type OrganizerProfile {
  displayName: String!
  organization: String
  phone: String
  homePlaceCode: String
  homePlaceName: String
  """Event types the organizer hosts (lookup tags)."""
  eventTypes: [Tag!]!
}

input UpdateOrganizerProfileInput {
  displayName: String
  organization: String
  """Contact phone (not the login phone)."""
  phone: String
  """A geo place code (the organizer's home region)."""
  homePlaceCode: String
  eventTypeCodes: [String!]
}
