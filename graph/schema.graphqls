# GraphQL schema for Agrofie gateway.
# Lookups are admin-controlled; clients must not hardcode genres/regions.

scalar Time

directive @authenticated on FIELD_DEFINITION
directive @hasRole(code: String!) on FIELD_DEFINITION

type Query {
  health: Health!
  me: User! @authenticated
  countries(activeOnly: Boolean = true): [Country!]!
  geoPlaces(countryCode: String = "GH", parentCode: String, activeOnly: Boolean = true): [GeoPlace!]!
  genres(activeOnly: Boolean = true): [Lookup!]!
  talentTypes(activeOnly: Boolean = true): [Lookup!]!
  eventTypes(activeOnly: Boolean = true): [Lookup!]!
  languages(activeOnly: Boolean = true): [Lookup!]!
  roles(activeOnly: Boolean = true): [Lookup!]!
  bookingStatuses(activeOnly: Boolean = true): [Lookup!]!
  rateUnits(activeOnly: Boolean = true): [Lookup!]!
  verificationTypes(activeOnly: Boolean = true): [Lookup!]!

  """The caller's own verification history, newest first. Requires the talent role."""
  myVerifications: [Verification!]! @hasRole(code: "talent")

  """Verifications awaiting review, oldest first. Requires the admin role."""
  pendingVerifications: [PendingVerification!]! @hasRole(code: "admin")

  """Searchable, active talent, newest first. Never exposes contact details."""
  searchTalent(filter: TalentFilter, first: Int = 20, after: String): TalentPage!
  talent(id: ID!): TalentProfile

  """The caller's own talent profile, including unpublished changes. Requires the talent role."""
  myTalentProfile: TalentProfile @hasRole(code: "talent")

  """Banks (BANK) or mobile money telcos (MOBILE_MONEY) a talent can settle payouts to."""
  settlementBanks(type: SettlementType!): [SettlementBank!]! @hasRole(code: "talent")

  """The caller's own payout account, if connected. Requires the talent role."""
  myPayoutAccount: PayoutAccount @hasRole(code: "talent")

  """The caller's own published availability, including blackout blocks and notes, in [from, to)."""
  myAvailability(from: String!, to: String!): [AvailabilityBlock!]! @hasRole(code: "talent")

  """A talent's public availability windows in [from, to). No notes."""
  talentAvailability(talentId: ID!, from: String!, to: String!): [AvailabilityWindow!]!

  """The caller's own bookings as the organizer who made them."""
  myBookingsAsOrganizer: [OrganizerBooking!]! @hasRole(code: "organizer")

  """The caller's own bookings as the talent they're for."""
  myBookingsAsTalent: [TalentBooking!]! @hasRole(code: "talent")

  """Full detail, including the contract once agreed. Only the organizer or talent involved can see it."""
  booking(id: ID!): BookingDetail @authenticated

  """A talent's public aggregate rating. Never review authorship at this level."""
  talentReviewSummary(talentId: ID!): ReviewSummary!
}

type Mutation {
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  logout: Boolean! @authenticated

  """Rename a lookup display name. Never changes immutable code."""
  updateLookupName(table: LookupTable!, code: String!, name: String!): Lookup! @hasRole(code: "admin")
  setLookupActive(table: LookupTable!, code: String!, isActive: Boolean!): Lookup! @hasRole(code: "admin")

  """Update the caller's own talent profile. A field left null is unchanged; an empty list clears that tag set."""
  updateMyTalentProfile(input: UpdateTalentProfileInput!): TalentProfile! @hasRole(code: "talent")

  """Replace all of the caller's current rates. Existing rates are closed, not deleted."""
  setMyRates(rates: [RateInput!]!): TalentProfile! @hasRole(code: "talent")

  """Connect (or replace) the caller's payout account via a Paystack subaccount. Test mode until launch review."""
  connectMyPayoutAccount(input: ConnectPayoutInput!): PayoutAccount! @hasRole(code: "talent")

  """Submit evidence for review. Approving an identity verification is what makes a talent searchable."""
  submitVerification(input: SubmitVerificationInput!): Verification! @hasRole(code: "talent")

  """Approve a pending verification. Requires the admin role."""
  approveVerification(id: ID!, reviewNotes: String): Verification! @hasRole(code: "admin")

  """Reject a pending verification. Requires the admin role."""
  rejectVerification(id: ID!, reviewNotes: String): Verification! @hasRole(code: "admin")

  """Publish a window as available, or carve out a blackout, on the caller's own profile."""
  addMyAvailabilityBlock(input: AddAvailabilityBlockInput!): AvailabilityBlock! @hasRole(code: "talent")

  """Remove one of the caller's own availability blocks."""
  removeMyAvailabilityBlock(id: ID!): Boolean! @hasRole(code: "talent")

  """Request a booking. Nothing is charged yet; the price is looked up server-side from the talent's published rate."""
  requestBooking(input: RequestBookingInput!): OrganizerBooking! @hasRole(code: "organizer")

  """Accept a pending inquiry. Snapshots the contract and moves the booking to agreed."""
  acceptBooking(id: ID!): TalentBooking! @hasRole(code: "talent")

  """Decline a pending inquiry."""
  declineBooking(id: ID!): TalentBooking! @hasRole(code: "talent")

  """Withdraw the caller's own pending inquiry. Once agreed, cancelling goes through a dispute instead."""
  cancelBooking(id: ID!): OrganizerBooking! @hasRole(code: "organizer")

  """Start a Paystack split checkout for an agreed booking the caller organized. The amount is never client-supplied; it is the booking's own snapshotted quote."""
  initiateCheckout(bookingId: ID!): Checkout! @hasRole(code: "organizer")

  """Reconciliation fallback: ask Paystack directly for the latest payment's status, and apply the same effect a webhook would if it succeeded."""
  verifyPayment(bookingId: ID!): Payment! @hasRole(code: "organizer")

  """Confirm a paid booking as completed, once the event window has passed. Either party may confirm it."""
  completeBooking(id: ID!): BookingDetail! @authenticated

  """Leave the caller's one review of the other party on a completed booking."""
  submitReview(input: SubmitReviewInput!): Review! @authenticated
}

input RegisterInput {
  email: String!
  phone: String
  password: String!
  displayName: String!
  roleCode: String!
}

input LoginInput {
  identifier: String!
  password: String!
}

type AuthPayload {
  sessionToken: String!
  user: User!
}

type User {
  id: ID!
  email: String!
  phone: String
  displayName: String!
  roleCodes: [String!]!
}

enum LookupTable {
  GENRES
  TALENT_TYPES
  EVENT_TYPES
  LANGUAGES
  ROLES
  BOOKING_STATUSES
  DISPUTE_REASONS
  CANCELLATION_REASONS
}

type Health {
  status: String!
  service: String!
  auth: String!
  booking: String!
  payments: String!
}

type Lookup {
  id: ID!
  code: String!
  name: String!
  sortOrder: Int!
  isActive: Boolean!
}

type Country {
  id: ID!
  code: String!
  name: String!
  isActive: Boolean!
}

type GeoPlace {
  id: ID!
  code: String!
  name: String!
  placeLevel: String!
  parentCode: String
  isActive: Boolean!
}

input TalentFilter {
  genreCodes: [String!]
  typeCodes: [String!]
  languageCodes: [String!]
  """A geo place code; matches that place and everything beneath it."""
  placeCode: String
}

type Tag {
  code: String!
  name: String!
}

type Rate {
  """Decimal string, e.g. "150.00"."""
  amount: String!
  currencyCode: String!
  rateUnitCode: String!
  eventTypeCode: String
}

type TalentCard {
  id: ID!
  displayName: String!
  headline: String
  homePlaceName: String
  """Cheapest current rate, if the talent has published one."""
  fromRate: Rate
  genres: [Tag!]!
  types: [Tag!]!
}

type TalentProfile {
  id: ID!
  displayName: String!
  headline: String
  homePlaceName: String
  bio: String
  genres: [Tag!]!
  types: [Tag!]!
  languages: [Tag!]!
  serviceAreas: [Tag!]!
  rates: [Rate!]!
}

type TalentPage {
  items: [TalentCard!]!
  """Pass as `after` for the next page; null when there are no more results."""
  nextCursor: String
}

input UpdateTalentProfileInput {
  headline: String
  bio: String
  """A geo place code; matches that place and everything beneath it is NOT implied here — this is the talent's home base, an exact place."""
  homePlaceCode: String
  genreCodes: [String!]
  typeCodes: [String!]
  languageCodes: [String!]
  serviceAreaCodes: [String!]
}

input RateInput {
  """Decimal string, e.g. "150.00"."""
  amount: String!
  currencyCode: String!
  rateUnitCode: String!
  eventTypeCode: String
}

enum SettlementType {
  BANK
  MOBILE_MONEY
}

input ConnectPayoutInput {
  businessName: String!
  settlementType: SettlementType!
  bankCode: String!
  accountNumber: String!
}

type SettlementBank {
  name: String!
  code: String!
}

type PayoutAccount {
  settlementType: SettlementType!
  bankName: String!
  """Last 4 digits only; the full account number is never returned or stored."""
  accountNumberLast4: String!
  accountName: String!
}

input SubmitVerificationInput {
  typeCode: String!
  evidenceRef: String
  notes: String
}

type Verification {
  id: ID!
  typeCode: String!
  typeName: String!
  statusCode: String!
  statusName: String!
  evidenceRef: String
  notes: String
  reviewNotes: String
}

"""One item in the admin review queue."""
type PendingVerification {
  id: ID!
  talentUserId: ID!
  talentDisplayName: String!
  typeCode: String!
  typeName: String!
  evidenceRef: String
  notes: String
}

"""Dates and times are ISO 8601 strings (e.g. "2026-11-01T00:00:00Z")."""
input AddAvailabilityBlockInput {
  startsAt: String!
  endsAt: String!
  isAvailable: Boolean!
  note: String
}

type AvailabilityBlock {
  id: ID!
  startsAt: String!
  endsAt: String!
  isAvailable: Boolean!
  note: String
}

"""Public-safe: no note."""
type AvailabilityWindow {
  id: ID!
  startsAt: String!
  endsAt: String!
  isAvailable: Boolean!
}

"""Dates and times are ISO 8601 strings (e.g. "2026-12-10T00:00:00Z")."""
input RequestBookingInput {
  talentId: ID!
  eventTypeCode: String
  placeCode: String
  startsAt: String!
  endsAt: String!
  venueText: String
  """Which of the talent's current published rates to quote. Never a client-supplied amount."""
  rateUnitCode: String!
  note: String
}

type OrganizerBooking {
  id: ID!
  statusCode: String!
  statusName: String!
  startsAt: String!
  endsAt: String!
  venueText: String
  quotedAmount: String!
  currencyCode: String!
  talentDisplayName: String!
  talentId: ID!
  eventTypeName: String
}

type TalentBooking {
  id: ID!
  statusCode: String!
  statusName: String!
  startsAt: String!
  endsAt: String!
  venueText: String
  quotedAmount: String!
  currencyCode: String!
  organizerDisplayName: String!
  organizerId: ID!
  eventTypeName: String
}

type BookingDetail {
  id: ID!
  statusCode: String!
  statusName: String!
  startsAt: String!
  endsAt: String!
  venueText: String
  quotedAmount: String!
  currencyCode: String!
  organizerDisplayName: String!
  talentDisplayName: String!
  eventTypeName: String
  """Only set once the booking has been accepted."""
  termsText: String
  """The most recent payment attempt for this booking, if any."""
  payment: Payment
  """Every review left on this booking (0, 1, or 2 — one per side)."""
  reviews: [Review!]!
}

input SubmitReviewInput {
  bookingId: ID!
  """1-5."""
  rating: Int!
  body: String
}

type Review {
  id: ID!
  rating: Int!
  body: String
  createdAt: String!
  authorUserId: ID!
  authorDisplayName: String!
}

type ReviewSummary {
  reviewCount: Int!
  averageRating: Float!
}

"""One Paystack split-checkout attempt for a booking. Amounts are
integer pesewas; commissionPesewas is what Agrofie keeps, the rest
settles to the talent's own subaccount."""
type Payment {
  reference: ID!
  statusCode: String!
  statusName: String!
  amountPesewas: Int!
  commissionPesewas: Int!
  currencyCode: String!
  checkoutUrl: String
}

type Checkout {
  checkoutUrl: String!
  reference: ID!
  amountPesewas: Int!
  commissionPesewas: Int!
}
